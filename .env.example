# Переменные окружения для локального запуска drink-me-bot.
# Скопируйте этот файл в `.env` и заполните значения (`.env` в git не попадает).

# --- Telegram ---
# Токен бота от @BotFather
TELEGRAM_BOT_TOKEN=
# Username бота без @ (например, my_drink_me_bot)
TELEGRAM_BOT_NAME=

# --- PostgreSQL (по умолчанию совпадает с compose.yaml) ---
PG_URL=jdbc:postgresql://localhost:5432/drink_me_bot
PG_USER=postgres
PG_PASSWORD=postgres

# --- Необязательно ---
# Порт HTTP-сервера (actuator), по умолчанию 8080
USE_PORT=8080

# Отключить автозапуск compose.yaml из Spring Boot (нужно, если Postgres уже запущен другим проектом на 5432)
SPRING_DOCKER_COMPOSE_ENABLED=false
